{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SideTask",
  "version": "0.2.0",
  "identifier": "com.changjin.sidetask",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "任务放在手边，注意力留在眼前。",
    "category": "Productivity",
    "windows": { "nsis": { "languages": ["SimpChinese", "English"] } },
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
